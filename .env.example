# ---------------------------------------------------------------------------
# Business Operations Dashboard — environment configuration
# Copy this file to `.env.local` (never commit `.env.local`).
# ---------------------------------------------------------------------------

# Base URL of the Spring Boot backend REST API (source of truth:
# business-operations-api-documentation.md, section 3).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Set to "true" to run the UI against the built-in, clearly-isolated mock API
# (useful while the backend is under development). Set to "false" for real API.
# The mock layer lives entirely in src/mocks and is tree-shaken out of the
# bundle when this flag is false.
VITE_USE_MOCKS=true

# Currency used by the number formatter (Intl). The sample contract data is
# denominated in INR (Indian Rupee).
VITE_CURRENCY_CODE=INR
